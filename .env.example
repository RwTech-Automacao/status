# Copie para .env.local ao rodar `vercel dev`. NAO comite o .env.local.
# Em producao, cadastre estes mesmos nomes em:
#   Vercel -> Settings -> Environment Variables

# Endereco do webhook de leitura no n8n
N8N_STATUS_URL=https://n8n.exemplo.com.br/webhook/status

# Opcional: casa com "Header Auth" no no Webhook do n8n (header x-status-token)
N8N_TOKEN=

# Login da pagina. Deixe STATUS_USER vazio para abrir o site ao publico.
STATUS_USER=rwtech
STATUS_PASS=troque-esta-senha
